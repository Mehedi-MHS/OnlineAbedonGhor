---
import Layout from '@/layouts/Layout.astro';
import ContactForm from '@/components/ContactForm';
import { faqs } from '@/data/content';
import { site } from '@/data/site';
import {
  ArrowRightIcon,
  ArrowUpRightIcon,
  ClockIcon,
  FacebookIcon,
  MailIcon,
  MapPinIcon,
  MessengerIcon,
  WhatsAppIcon,
} from '@/components/icons';

const channels = [
  {
    title: 'WhatsApp',
    description: 'দ্রুততম উত্তর পেতে সরাসরি মেসেজ করুন।',
    href: site.whatsapp,
    label: 'মেসেজ করুন',
    icon: 'whatsapp',
    tone: 'bg-[#25D366] text-ink-950',
  },
  {
    title: 'Messenger',
    description: 'ফেসবুক পেজে মেসেজ দিয়ে সাহায্য নিন।',
    href: site.messenger,
    label: 'Messenger খুলুন',
    icon: 'messenger',
    tone: 'bg-[#0084FF] text-white',
  },
  {
    title: 'ফেসবুক গ্রুপ',
    description: 'আবেদন সংক্রান্ত সব আপডেট ও আলোচনা।',
    href: site.facebookGroup,
    label: 'গ্রুপে জয়েন করুন',
    icon: 'facebook',
    tone: 'bg-[#1877F2] text-white',
  },
  {
    title: 'ইমেইল',
    description: 'বিস্তারিত লিখে পাঠাতে চাইলে ইমেইল করুন।',
    href: `mailto:${site.email}`,
    label: site.email,
    icon: 'email',
    tone: 'bg-ink-950 text-white',
  },
] as const;
---

<Layout
  title="যোগাযোগ করুন"
  description="সিভি, ছবি থেকে পিডিএফ বা যেকোনো প্রশ্নে আমাদের সাথে যোগাযোগ করুন — WhatsApp, Messenger, ইমেইল অথবা ফেসবুক গ্রুপে।"
>
  <section class="relative overflow-hidden border-b border-ink-100 bg-ink-50/60">
    <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-32 left-1/4 h-64 w-64 rounded-full bg-brand-500/5 blur-3xl" aria-hidden="true"></div>

    <div class="container-page relative py-10 sm:py-14">
      <nav aria-label="ব্রেডক্রাম্ব" class="flex items-center gap-2 text-xs font-medium text-ink-500">
        <a href="/" class="transition hover:text-brand-600">হোম</a>
        <span aria-hidden="true">/</span>
        <span class="text-ink-900" aria-current="page">যোগাযোগ</span>
      </nav>

      <div class="mt-5 max-w-2xl">
        <p class="eyebrow">আমরা পাশে আছি</p>
        <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
          যোগাযোগ <span class="text-brand-600">করুন</span>
        </h1>
        <p class="mt-3 text-sm leading-relaxed text-ink-500 sm:text-base">
          কোনো সমস্যা, প্রশ্ন বা পরামর্শ থাকলে জানান। WhatsApp বা Messenger-এ সরাসরি
          মেসেজ করতে পারেন, অথবা নিচের ফর্মটি পূরণ করুন।
        </p>
      </div>
    </div>
  </section>

  <section class="py-10 sm:py-14" aria-labelledby="channels-title">
    <div class="container-page">
      <h2 id="channels-title" class="sr-only">যোগাযোগের মাধ্যম</h2>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {channels.map((channel) => (
          <a
            href={channel.href}
            target={channel.href.startsWith('http') ? '_blank' : undefined}
            rel={channel.href.startsWith('http') ? 'noopener noreferrer' : undefined}
            class="group flex flex-col rounded-2xl border border-ink-100 bg-white p-5 shadow-card transition duration-300 hover:-translate-y-1 hover:border-brand-200 hover:shadow-soft"
          >
            <span class={`inline-flex h-12 w-12 items-center justify-center rounded-xl ${channel.tone}`}>
              {channel.icon === 'whatsapp' && <WhatsAppIcon className="h-6 w-6" />}
              {channel.icon === 'messenger' && <MessengerIcon className="h-6 w-6" />}
              {channel.icon === 'facebook' && <FacebookIcon className="h-6 w-6" />}
              {channel.icon === 'email' && <MailIcon className="h-6 w-6" />}
            </span>
            <h3 class="mt-4 text-base font-bold text-ink-950">{channel.title}</h3>
            <p class="mt-1 flex-1 text-sm leading-relaxed text-ink-500">{channel.description}</p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-xs font-semibold text-brand-600">
              {channel.label}
              <ArrowUpRightIcon className="h-3.5 w-3.5 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="pb-16 sm:pb-20" aria-labelledby="contact-form-title">
    <div class="container-page">
      <div class="grid gap-6 lg:grid-cols-[1.4fr_1fr] lg:items-start">
        <div>
          <h2 id="contact-form-title" class="sr-only">মেসেজ ফর্ম</h2>
          <ContactForm client:load />
        </div>

        <aside class="space-y-4">
          <div class="card p-5 sm:p-6">
            <h2 class="text-lg font-bold text-ink-950">সরাসরি যোগাযোগ</h2>
            <ul class="mt-4 space-y-4 text-sm">
              <li class="flex items-start gap-3">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                  <WhatsAppIcon className="h-4 w-4" />
                </span>
                <div>
                  <p class="font-semibold text-ink-900">WhatsApp</p>
                  <a
                    href={site.whatsapp}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="mt-0.5 inline-flex items-center gap-1 text-xs text-brand-600 hover:underline"
                  >
                    {site.phone}
                    <ArrowUpRightIcon className="h-3 w-3" />
                  </a>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                  <MailIcon className="h-4 w-4" />
                </span>
                <div>
                  <p class="font-semibold text-ink-900">ইমেইল</p>
                  <a
                    href={`mailto:${site.email}`}
                    class="mt-0.5 block text-xs break-all text-brand-600 hover:underline"
                  >
                    {site.email}
                  </a>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                  <MapPinIcon className="h-4 w-4" />
                </span>
                <div>
                  <p class="font-semibold text-ink-900">অবস্থান</p>
                  <p class="mt-0.5 text-xs text-ink-500">ঢাকা, বাংলাদেশ</p>
                </div>
              </li>
              <li class="flex items-start gap-3">
                <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
                  <ClockIcon className="h-4 w-4" />
                </span>
                <div>
                  <p class="font-semibold text-ink-900">উত্তর দেওয়ার সময়</p>
                  <p class="mt-0.5 text-xs text-ink-500">প্রতিদিন সকাল ৯টা – রাত ১০টা</p>
                </div>
              </li>
            </ul>
          </div>

          <div class="relative overflow-hidden rounded-2xl bg-ink-950 p-5 text-white sm:p-6">
            <div class="pointer-events-none absolute -top-16 -right-12 h-44 w-44 rounded-full bg-brand-500/25 blur-2xl" aria-hidden="true"></div>
            <div class="relative">
              <span class="inline-flex h-10 w-10 items-center justify-center rounded-xl bg-[#1877F2] text-white">
                <FacebookIcon className="h-5 w-5" />
              </span>
              <h2 class="mt-3 text-base font-bold text-white">ফেসবুক গ্রুপে জয়েন করুন</h2>
              <p class="mt-1.5 text-xs leading-relaxed text-white/60">
                আবেদন সংক্রান্ত যাবতীয় আপডেট, নতুন সুযোগ আর পরামর্শ পেতে আমাদের
                ‘আবেদন ঘর’ গ্রুপে যোগ দিন।
              </p>
              <a
                href={site.facebookGroup}
                target="_blank"
                rel="noopener noreferrer"
                class="btn mt-4 w-full bg-white !py-2.5 text-sm text-ink-950 hover:bg-brand-50"
              >
                গ্রুপে জয়েন করুন
                <ArrowRightIcon className="h-4 w-4" />
              </a>
            </div>
          </div>

          <div class="rounded-2xl border border-brand-100 bg-brand-50/60 p-5 text-xs leading-relaxed text-ink-600">
            <p class="font-bold text-ink-900">দ্রুত উত্তর পেতে</p>
            <p class="mt-1">
              WhatsApp-এ মেসেজ করার সময় আপনার সমস্যার স্ক্রিনশট বা ছবি দিলে আমরা দ্রুত
              সাহায্য করতে পারব।
            </p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section id="faq" class="border-t border-ink-100 bg-ink-50/60 py-16 sm:py-20" aria-labelledby="faq-title">
    <div class="container-page">
      <div class="mx-auto max-w-3xl">
        <div class="text-center">
          <p class="eyebrow">সাধারণ প্রশ্ন</p>
          <h2 id="faq-title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
            আপনার প্রশ্নের <span class="text-brand-600">উত্তর</span>
          </h2>
          <p class="mt-3 text-sm text-ink-500">
            আরও কিছু জানতে চাইলে আমাদের মেসেজ করুন — আমরা সাহায্য করতে প্রস্তুত।
          </p>
        </div>

        <div class="mt-8 space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-2xl border border-ink-100 bg-white p-5 shadow-sm open:border-brand-200">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-bold text-ink-950 marker:hidden">
                {faq.q}
                <span class="inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-ink-50 text-ink-500 transition group-open:rotate-45 group-open:bg-brand-50 group-open:text-brand-600">
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                </span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed text-ink-500">{faq.a}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>
</Layout>
