---
import Layout from '@/layouts/Layout.astro';
import { features } from '@/data/content';
import { site } from '@/data/site';
import {
  ArrowRightIcon,
  ArrowUpRightIcon,
  CheckIcon,
  FacebookIcon,
  FileCvIcon,
  FilePdfIcon,
  MessengerIcon,
  ShieldIcon,
  SparklesIcon,
  WhatsAppIcon,
} from '@/components/icons';

const steps = [
  {
    number: '০১',
    title: 'টুলটি বেছে নিন',
    description: 'ছবি থেকে পিডিএফ অথবা সিভি মেকার — যেটা দরকার সেটায় ক্লিক করুন।',
  },
  {
    number: '০২',
    title: 'তথ্য দিন বা ছবি যোগ করুন',
    description: 'কোনো রেজিস্ট্রেশন নেই। সরাসরি ছবি আপলোড করুন বা ফর্ম পূরণ করুন।',
  },
  {
    number: '০৩',
    title: 'ডাউনলোড করে ব্যবহার করুন',
    description: 'তৈরি ফাইল সাথে সাথে ডাউনলোড করুন — সম্পূর্ণ ফ্রি, কোনো ওয়াটারমার্ক নেই।',
  },
];
---

<Layout>
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-ink-950">
    <img
      src="/images/hero.svg"
      alt=""
      width="1600"
      height="760"
      fetchpriority="high"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-right"
    />
    <div
      class="absolute inset-0 -z-10 bg-gradient-to-r from-ink-950 via-ink-950/90 to-ink-950/20 max-lg:via-ink-950/85 max-lg:to-ink-950/60"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-40 bg-gradient-to-t from-ink-950 to-transparent"
      aria-hidden="true"
    ></div>

    <div class="container-page relative">
      <div class="max-w-2xl py-20 sm:py-24 lg:py-32">
        <p class="animate-fade-up inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-3.5 py-1.5 text-xs font-semibold text-brand-300 backdrop-blur">
          <SparklesIcon className="h-4 w-4" />
          সম্পূর্ণ ফ্রি • বাংলায় তৈরি • রেজিস্ট্রেশন ছাড়াই
        </p>

        <h1 class="mt-6 animate-fade-up text-4xl leading-[1.15] font-bold tracking-tight text-white [animation-delay:80ms] sm:text-5xl lg:text-[3.9rem]">
          আবেদনের সব কাজ,
          <span class="relative mt-2 block w-fit text-brand-400">
            এখন এক জায়গায়
            <svg
              viewBox="0 0 300 14"
              class="absolute -bottom-2 left-0 h-3 w-full text-brand-500/70"
              fill="none"
              aria-hidden="true"
              preserveAspectRatio="none"
            >
              <path d="M2 11C60 4 120 2 180 5c40 2 80 5 118 4" stroke="currentColor" stroke-width="4" stroke-linecap="round"></path>
            </svg>
          </span>
        </h1>

        <p class="mt-7 max-w-xl animate-fade-up text-base leading-relaxed text-white/65 [animation-delay:160ms] sm:text-lg">
          মোবাইলের ছবি থেকে পরিষ্কার PDF বানান, মিনিটেই তৈরি করুন প্রফেশনাল সিভি — আর
          আবেদন সংক্রান্ত সব আপডেট পান এক জায়গায়। সব টুল <strong class="font-semibold text-white">১০০% ফ্রি</strong>।
        </p>

        <div class="mt-8 flex animate-fade-up flex-col gap-3 [animation-delay:240ms] sm:flex-row sm:items-center">
          <a href="/picture-to-pdf" class="btn-primary !px-6 !py-3.5 text-base">
            <FilePdfIcon className="h-5 w-5" />
            ছবি থেকে পিডিএফ বানান
            <ArrowRightIcon className="h-4 w-4" />
          </a>
          <a
            href="/cv-maker"
            class="btn inline-flex border border-white/20 bg-white/5 px-6 py-3.5 text-base text-white backdrop-blur transition hover:bg-white/10"
          >
            <FileCvIcon className="h-5 w-5" />
            সিভি তৈরি করুন
          </a>
        </div>

        <ul class="mt-9 flex animate-fade-up flex-wrap gap-x-6 gap-y-2.5 text-sm text-white/60 [animation-delay:320ms]">
          <li class="flex items-center gap-2">
            <CheckIcon className="h-4 w-4 text-brand-400" />
            ১০০% ফ্রি
          </li>
          <li class="flex items-center gap-2">
            <ShieldIcon className="h-4 w-4 text-brand-400" />
            ফাইল সার্ভারে যায় না
          </li>
          <li class="flex items-center gap-2">
            <CheckIcon className="h-4 w-4 text-brand-400" />
            কোনো সাইন-আপ নেই
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Quick navigation box -->
  <section class="relative z-10" aria-label="দ্রুত টুলস">
    <div class="container-page">
      <div class="grid gap-4 pt-8 sm:grid-cols-2 lg:-mt-14 lg:gap-5 lg:pt-0">
        <a
          href="/picture-to-pdf"
          class="group flex items-center gap-4 rounded-2xl border border-ink-100 bg-white p-5 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-brand-200 sm:p-6"
        >
          <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-brand-500 text-white shadow-glow transition group-hover:scale-105">
            <FilePdfIcon className="h-7 w-7" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-base font-bold text-ink-950 sm:text-lg">
              ছবি থেকে পিডিএফ কনভার্ট করুন ফ্রি
            </span>
            <span class="mt-0.5 block text-sm text-ink-500">
              একাধিক ছবি সাজিয়ে একটি PDF ফাইল
            </span>
          </span>
          <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ink-50 text-ink-500 transition group-hover:bg-brand-50 group-hover:text-brand-600">
            <ArrowUpRightIcon className="h-4 w-4" />
          </span>
        </a>

        <a
          href="/cv-maker"
          class="group flex items-center gap-4 rounded-2xl border border-ink-100 bg-white p-5 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-brand-200 sm:p-6"
        >
          <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-ink-950 text-white transition group-hover:scale-105">
            <FileCvIcon className="h-7 w-7" />
          </span>
          <span class="min-w-0 flex-1">
            <span class="block text-base font-bold text-ink-950 sm:text-lg">
              সিভি তৈরি করুন ফ্রি
            </span>
            <span class="mt-0.5 block text-sm text-ink-500">
              ফর্ম পূরণ করে মিনিটেই প্রফেশনাল সিভি
            </span>
          </span>
          <span class="inline-flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-ink-50 text-ink-500 transition group-hover:bg-brand-50 group-hover:text-brand-600">
            <ArrowUpRightIcon className="h-4 w-4" />
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Personal help + Facebook group card -->
  <section class="py-14 sm:py-20" aria-labelledby="help-title">
    <div class="container-page">
      <div class="relative overflow-hidden rounded-3xl bg-ink-950 p-6 text-white shadow-soft sm:p-9 lg:p-11">
        <div
          class="pointer-events-none absolute -top-24 -right-20 h-72 w-72 rounded-full bg-brand-500/25 blur-3xl"
          aria-hidden="true"
        ></div>
        <div
          class="pointer-events-none absolute -bottom-28 left-1/3 h-64 w-64 rounded-full bg-brand-600/15 blur-3xl"
          aria-hidden="true"
        ></div>

        <div class="relative grid gap-8 lg:grid-cols-[1.1fr_1fr] lg:items-center">
          <div>
            <p class="eyebrow border-brand-500/30 bg-brand-500/10 text-brand-300">
              <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
              সরাসরি সহায়তা
            </p>
            <h2 id="help-title" class="mt-4 text-2xl font-bold text-white sm:text-3xl">
              ব্যক্তিগতভাবে হেল্প পেতে যোগাযোগ করুন
            </h2>
            <p class="mt-3 max-w-xl text-sm leading-relaxed text-white/60 sm:text-base">
              পিডিএফ বানাতে বা সিভি তৈরি করতে সমস্যা হচ্ছে? WhatsApp বা Messenger-এ
              মেসেজ করুন — আমরা যতটা সম্ভব দ্রুত সাহায্য করার চেষ্টা করব।
            </p>
          </div>

          <div class="grid gap-3 sm:grid-cols-2">
            <a
              href={site.whatsapp}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-[#25D366]/50 hover:bg-[#25D366]/10"
            >
              <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#25D366] text-ink-950">
                <WhatsAppIcon className="h-6 w-6" />
              </span>
              <span>
                <span class="block text-sm font-bold text-white">WhatsApp</span>
                <span class="block text-xs text-white/50">সরাসরি মেসেজ দিন</span>
              </span>
              <ArrowUpRightIcon className="ml-auto h-4 w-4 text-white/30 transition group-hover:text-white" />
            </a>
            <a
              href={site.messenger}
              target="_blank"
              rel="noopener noreferrer"
              class="group flex items-center gap-3 rounded-2xl border border-white/10 bg-white/5 p-4 transition hover:border-[#0084FF]/50 hover:bg-[#0084FF]/10"
            >
              <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-[#0084FF] text-white">
                <MessengerIcon className="h-6 w-6" />
              </span>
              <span>
                <span class="block text-sm font-bold text-white">Messenger</span>
                <span class="block text-xs text-white/50">পেজে মেসেজ করুন</span>
              </span>
              <ArrowUpRightIcon className="ml-auto h-4 w-4 text-white/30 transition group-hover:text-white" />
            </a>
          </div>
        </div>

        <div class="relative mt-8 flex flex-col gap-4 border-t border-white/10 pt-6 sm:flex-row sm:items-center sm:justify-between">
          <div class="flex items-start gap-3">
            <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[#1877F2] text-white">
              <FacebookIcon className="h-5 w-5" />
            </span>
            <p class="max-w-2xl text-sm leading-relaxed text-white/65">
              আবেদন সংক্রান্ত যাবতীয় আপডেট পেতে জয়েন করুন
              <strong class="font-semibold text-white"> ‘আবেদন ঘর’ ফেসবুক গ্রুপে</strong>।
            </p>
          </div>
          <a
            href={site.facebookGroup}
            target="_blank"
            rel="noopener noreferrer"
            class="btn shrink-0 bg-white px-5 py-2.5 text-sm text-ink-950 hover:bg-brand-50"
          >
            গ্রুপে জয়েন করুন
            <ArrowRightIcon className="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature cards -->
  <section class="pb-16 sm:pb-24" aria-labelledby="features-title">
    <div class="container-page">
      <div class="mx-auto max-w-2xl text-center">
        <p class="eyebrow">কেন আমাদের সাইট</p>
        <h2 id="features-title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          আবেদনের জন্য যা যা দরকার, <span class="text-brand-600">সব এখানেই</span>
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-ink-500 sm:text-base">
          সময় বাঁচান, ঝামেলা এড়ান। সহজ টুল আর দরকারি তথ্য দিয়ে আপনার আবেদন প্রক্রিয়া
          করুন আরও সহজ।
        </p>
      </div>

      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {features.map((feature) => (
          <article class="group flex flex-col overflow-hidden rounded-2xl border border-ink-100 bg-white shadow-card transition duration-300 hover:-translate-y-1 hover:shadow-soft">
            <div class="relative aspect-[16/10] overflow-hidden bg-ink-950">
              <img
                src={feature.image}
                alt={feature.title}
                width="640"
                height="420"
                loading="lazy"
                class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
              />
            </div>
            <div class="flex flex-1 flex-col p-5">
              <h3 class="text-lg font-bold text-ink-950">{feature.title}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-ink-500">
                {feature.description}
              </p>
              {feature.href && (
                <a
                  href={feature.href}
                  class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-600 transition hover:gap-2.5 hover:text-brand-700"
                >
                  {feature.linkLabel}
                  <ArrowRightIcon className="h-4 w-4" />
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-y border-ink-100 bg-ink-50/60 py-16 sm:py-24" aria-labelledby="steps-title">
    <div class="container-page">
      <div class="grid gap-10 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:gap-16">
        <div>
          <p class="eyebrow">মাত্র ৩ ধাপে</p>
          <h2 id="steps-title" class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
            শুরু করা সহজ, <br class="hidden sm:block" />
            ফলাফল <span class="text-brand-600">সাথে সাথে</span>
          </h2>
          <p class="mt-4 max-w-lg text-sm leading-relaxed text-ink-500 sm:text-base">
            কোনো অ্যাপ ইনস্টল করতে হবে না, অ্যাকাউন্ট খুলতে হবে না। ব্রাউজার খুলুন, কাজ
            শেষ করুন — ব্যস।
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="/picture-to-pdf" class="btn-dark">
              পিডিএফ টুল ব্যবহার করুন
              <ArrowRightIcon className="h-4 w-4" />
            </a>
            <a href="/contact" class="btn-outline">প্রশ্ন আছে?</a>
          </div>
        </div>

        <ol class="relative space-y-4">
          {steps.map((step, index) => (
            <li class="relative flex gap-4 rounded-2xl border border-ink-100 bg-white p-5 shadow-sm sm:gap-5 sm:p-6">
              <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-brand-500/10 text-lg font-bold text-brand-600">
                {step.number}
              </span>
              <div>
                <h3 class="text-base font-bold text-ink-950 sm:text-lg">{step.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-500">{step.description}</p>
              </div>
              {index < steps.length - 1 && (
                <span class="absolute top-full left-[2.4rem] hidden h-4 w-px bg-ink-200 sm:block" aria-hidden="true"></span>
              )}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="py-16 sm:py-20">
    <div class="container-page">
      <div class="relative overflow-hidden rounded-3xl bg-brand-500 px-6 py-12 text-center sm:px-12 sm:py-16">
        <div class="pointer-events-none absolute inset-0 opacity-20" aria-hidden="true">
          <div class="absolute -top-20 -left-16 h-64 w-64 rounded-full border-[40px] border-ink-950"></div>
          <div class="absolute -right-10 -bottom-24 h-72 w-72 rounded-full border-[40px] border-white"></div>
        </div>
        <div class="relative mx-auto max-w-2xl">
          <h2 class="text-3xl font-bold tracking-tight text-ink-950 sm:text-4xl">
            আজই আপনার আবেদনের কাজ শুরু করুন
          </h2>
          <p class="mx-auto mt-3 max-w-xl text-sm leading-relaxed text-ink-900/70 sm:text-base">
            ছবি থেকে পিডিএফ হোক বা সিভি — সবকিছু ফ্রি, নিরাপদ এবং মোবাইল-বান্ধব।
          </p>
          <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
            <a href="/picture-to-pdf" class="btn bg-ink-950 px-6 py-3.5 text-white hover:bg-ink-800">
              <FilePdfIcon className="h-5 w-5" />
              পিডিএফ বানান
            </a>
            <a
              href="/cv-maker"
              class="btn border border-ink-950/20 bg-white/90 px-6 py-3.5 text-ink-950 hover:bg-white"
            >
              <FileCvIcon className="h-5 w-5" />
              সিভি তৈরি করুন
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
