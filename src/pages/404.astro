---
import Layout from '@/layouts/Layout.astro';
import { ArrowRightIcon, FileCvIcon, FilePdfIcon } from '@/components/icons';
---

<Layout
  title="পেজটি খুঁজে পাওয়া যায়নি"
  description="আপনি যে পেজটি খুঁজছেন সেটি পাওয়া যায়নি। হোমপেজে ফিরে যান অথবা আমাদের টুলগুলো ব্যবহার করুন।"
  noIndex
>
  <section class="relative overflow-hidden bg-ink-50/60 py-20 sm:py-28">
    <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true"></div>
    <div class="container-page relative">
      <div class="mx-auto max-w-2xl text-center">
        <p class="text-7xl font-bold tracking-tight text-brand-500 sm:text-8xl">৪০৪</p>
        <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl">
          পেজটি খুঁজে পাওয়া যায়নি
        </h1>
        <p class="mx-auto mt-3 max-w-lg text-sm leading-relaxed text-ink-500 sm:text-base">
          দুঃখিত, আপনি যে পেজটি খুঁজছেন সেটি সরিয়ে ফেলা হয়েছে অথবা লিংকটি ভুল।
          নিচের বাটন থেকে হোমপেজে ফিরে যান বা সরাসরি টুলটি ব্যবহার করুন।
        </p>
        <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
          <a href="/" class="btn-primary">
            হোমপেজে ফিরে যান
            <ArrowRightIcon className="h-4 w-4" />
          </a>
          <a href="/picture-to-pdf" class="btn-outline">
            <FilePdfIcon className="h-4 w-4" />
            ছবি থেকে পিডিএফ
          </a>
          <a href="/cv-maker" class="btn-outline">
            <FileCvIcon className="h-4 w-4" />
            সিভি মেকার
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
