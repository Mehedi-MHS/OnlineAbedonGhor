---
import Layout from '@/layouts/Layout.astro';
import PictureToPdf from '@/components/PictureToPdf';
import { ArrowRightIcon, CheckIcon, FilePdfIcon, ShieldIcon, SparklesIcon } from '@/components/icons';

const benefits = [
  {
    title: 'সাথে সাথে রূপান্তর',
    description: 'ছবি যোগ করে এক ক্লিকেই PDF ডাউনলোড করুন — কোনো অপেক্ষা নেই।',
  },
  {
    title: 'পৃষ্ঠার ক্রম নিয়ন্ত্রণ',
    description: 'ছবি উপরে-নিচে সাজিয়ে ঠিক করুন কোন ছবি কোন পৃষ্ঠায় থাকবে।',
  },
  {
    title: 'সম্পূর্ণ প্রাইভেট',
    description: 'সব প্রসেসিং ব্রাউজারে হয়, তাই ছবি কোথাও আপলোড হয় না।',
  },
];
---

<Layout
  title="ছবি থেকে পিডিএফ কনভার্টার — ফ্রি"
  description="একাধিক ছবি এক ক্লিকে একটি PDF ফাইলে রূপান্তর করুন। সম্পূর্ণ ফ্রি, ওয়াটারমার্ক ছাড়া, সরাসরি ব্রাউজারেই — কোনো ছবি সার্ভারে আপলোড হয় না।"
>
  <!-- Page header -->
  <section class="relative overflow-hidden border-b border-ink-100 bg-ink-50/60">
    <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-32 left-1/4 h-64 w-64 rounded-full bg-brand-500/5 blur-3xl" aria-hidden="true"></div>

    <div class="container-page relative py-10 sm:py-14">
      <nav aria-label="ব্রেডক্রাম্ব" class="flex items-center gap-2 text-xs font-medium text-ink-500">
        <a href="/" class="transition hover:text-brand-600">হোম</a>
        <span aria-hidden="true">/</span>
        <span class="text-ink-900" aria-current="page">ছবি থেকে পিডিএফ</span>
      </nav>

      <div class="mt-5 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">
            <SparklesIcon className="h-3.5 w-3.5" />
            সম্পূর্ণ ফ্রি টুল
          </p>
          <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            ছবি থেকে <span class="text-brand-600">পিডিএফ</span> কনভার্ট করুন
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-ink-500 sm:text-base">
            মোবাইল বা কম্পিউটার থেকে একাধিক ছবি নির্বাচন করুন, সাজান, তারপর একটি
            পরিষ্কার PDF ফাইলে রূপান্তর করুন। কোনো সাইন-আপ নেই, ওয়াটারমার্ক নেই।
          </p>
        </div>

        <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-ink-600">
          <span class="inline-flex items-center gap-1.5">
            <CheckIcon className="h-4 w-4 text-brand-600" />
            ওয়াটারমার্ক নেই
          </span>
          <span class="inline-flex items-center gap-1.5">
            <ShieldIcon className="h-4 w-4 text-brand-600" />
            ফাইল আপলোড হয় না
          </span>
          <span class="inline-flex items-center gap-1.5">
            <FilePdfIcon className="h-4 w-4 text-brand-600" />
            A4 ও Letter
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="py-8 sm:py-12">
    <div class="container-page">
      <PictureToPdf client:load />
    </div>
  </section>

  <section class="pb-16 sm:pb-20">
    <div class="container-page">
      <div class="grid gap-4 sm:grid-cols-3">
        {benefits.map((benefit) => (
          <div class="rounded-2xl border border-ink-100 bg-white p-5 shadow-sm">
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-lg bg-brand-50 text-brand-600">
              <CheckIcon className="h-4 w-4" />
            </span>
            <h2 class="mt-3 text-base font-bold text-ink-950">{benefit.title}</h2>
            <p class="mt-1.5 text-sm leading-relaxed text-ink-500">{benefit.description}</p>
          </div>
        ))}
      </div>

      <div class="mt-10 rounded-2xl border border-ink-100 bg-white p-6 sm:p-8">
        <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
          <div>
            <h2 class="text-xl font-bold text-ink-950">এরপর সিভি বানাতে হবে?</h2>
            <p class="mt-1.5 text-sm text-ink-500">
              ফ্রি সিভি মেকার দিয়ে মিনিটেই তৈরি করুন সাজানো প্রফেশনাল সিভি।
            </p>
          </div>
          <a href="/cv-maker" class="btn-dark shrink-0">
            সিভি মেকার দেখুন
            <ArrowRightIcon className="h-4 w-4" />
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
