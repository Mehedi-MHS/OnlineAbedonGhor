---
import Layout from '@/layouts/Layout.astro';
import CvMaker from '@/components/CvMaker';
import { CheckIcon, FilePdfIcon, PrinterIcon, SparklesIcon } from '@/components/icons';

const tips = [
  'সংক্ষিপ্ত ও পরিষ্কার বাক্যে নিজের অভিজ্ঞতা লিখুন।',
  'প্রতিটি চাকরির জন্য সিভির সারসংক্ষেপ ও দক্ষতা কিছুটা বদলান।',
  'অভিজ্ঞতার বুলেটে সংখ্যা দিয়ে অর্জন দেখান, যেমন “২০% সময় বাঁচিয়েছি”।',
  'ছবি বা অতিরিক্ত তথ্য না দিয়ে এক থেকে দুই পৃষ্ঠায় সিভি রাখুন।',
];
---

<Layout
  title="ফ্রি সিভি মেকার — মিনিটেই প্রফেশনাল সিভি"
  description="সহজ ফর্ম পূরণ করে মিনিটেই তৈরি করুন প্রফেশনাল সিভি। বাংলা বা ইংরেজিতে লিখুন, লাইভ প্রিভিউ দেখুন এবং PDF ডাউনলোড করুন — সম্পূর্ণ ফ্রি।"
>
  <section class="no-print relative overflow-hidden border-b border-ink-100 bg-ink-50/60">
    <div class="pointer-events-none absolute -top-24 right-0 h-72 w-72 rounded-full bg-brand-500/10 blur-3xl" aria-hidden="true"></div>
    <div class="pointer-events-none absolute -bottom-32 left-1/4 h-64 w-64 rounded-full bg-brand-500/5 blur-3xl" aria-hidden="true"></div>

    <div class="container-page relative py-10 sm:py-14">
      <nav aria-label="ব্রেডক্রাম্ব" class="flex items-center gap-2 text-xs font-medium text-ink-500">
        <a href="/" class="transition hover:text-brand-600">হোম</a>
        <span aria-hidden="true">/</span>
        <span class="text-ink-900" aria-current="page">সিভি মেকার</span>
      </nav>

      <div class="mt-5 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
        <div class="max-w-2xl">
          <p class="eyebrow">
            <SparklesIcon className="h-3.5 w-3.5" />
            ফ্রি সিভি মেকার
          </p>
          <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">
            মিনিটেই তৈরি করুন <span class="text-brand-600">প্রফেশনাল সিভি</span>
          </h1>
          <p class="mt-3 text-sm leading-relaxed text-ink-500 sm:text-base">
            নিচের ফর্মে তথ্য দিন — পাশেই তৈরি হবে আপনার সাজানো A4 সিভি। বাংলা বা
            ইংরেজি, যেকোনো ভাষায় লিখুন। শেষে এক ক্লিকে PDF ডাউনলোড করুন।
          </p>
        </div>

        <div class="flex flex-wrap gap-x-5 gap-y-2 text-sm text-ink-600">
          <span class="inline-flex items-center gap-1.5">
            <CheckIcon className="h-4 w-4 text-brand-600" />
            লাইভ প্রিভিউ
          </span>
          <span class="inline-flex items-center gap-1.5">
            <PrinterIcon className="h-4 w-4 text-brand-600" />
            A4 প্রিন্ট-রেডি
          </span>
          <span class="inline-flex items-center gap-1.5">
            <FilePdfIcon className="h-4 w-4 text-brand-600" />
            ফ্রি PDF
          </span>
        </div>
      </div>
    </div>
  </section>

  <section class="cv-tool-section py-8 sm:py-12">
    <div class="container-page">
      <CvMaker client:load />
    </div>
  </section>

  <section class="no-print pb-16 sm:pb-20">
    <div class="container-page">
      <div class="rounded-2xl border border-ink-100 bg-white p-6 sm:p-8">
        <div class="grid gap-8 lg:grid-cols-[1fr_1.2fr] lg:items-center">
          <div>
            <p class="eyebrow">সিভি টিপস</p>
            <h2 class="mt-3 text-2xl font-bold text-ink-950">
              সিভি যেন <span class="text-brand-600">আলাদা</span> করে
            </h2>
            <p class="mt-2 text-sm leading-relaxed text-ink-500">
              নিয়োগকর্তা গড়ে কয়েক সেকেন্ডেই একটি সিভি দেখেন। সহজ কিছু নিয়ম মেনে
              আপনার সিভিকে আরও কার্যকর করুন।
            </p>
          </div>
          <ul class="space-y-3">
            {tips.map((tip) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed text-ink-600">
                <span class="mt-0.5 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-50 text-brand-600">
                  <CheckIcon className="h-3.5 w-3.5" />
                </span>
                {tip}
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>
</Layout>
